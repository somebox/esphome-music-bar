# Credentials — never commit. Copy secrets.yaml.example and fill it in.
secrets.yaml
.env

# Your own configuration, derived from music-bar.config.example.yaml
music-bar.config.yaml

# ESPHome build output
.esphome/
*.bin
*.elf

# Per-device ESPHome YAMLs. The shared configs are tracked; anything you copy
# for your own panel is not.
esphome/*.yaml
!esphome/music-bar.base.yaml
!esphome/music-bar.example.yaml
!esphome/music-bar.factory.yaml
!esphome/music-bar.factory.factory.yaml
!esphome/probe-image-slots.yaml
!esphome/secrets-example.yaml
esphome/secrets.yaml

# Python
__pycache__/
.pytest_cache/
.venv/

# Downloaded artwork cache
.artwork-cache/

# Your own artwork stays yours and stays local. Station logos and album art
# are somebody else's copyright, so nothing under overrides/ is tracked —
# a fork cannot accidentally publish them.
overrides/*
!overrides/README.md

.DS_Store
