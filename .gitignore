# Credentials — never commit. Copy secrets.yaml.example and fill it in.
secrets.yaml
.env

# Your own configuration, derived from ma-bar.config.example.yaml
ma-bar.config.yaml

# ESPHome build output
.esphome/
*.bin
*.elf

# Downloaded artwork cache
.artwork-cache/

# Your own artwork stays yours and stays local. Station logos and album art
# are somebody else's copyright, so nothing under overrides/ is tracked —
# a fork cannot accidentally publish them.
overrides/*
!overrides/README.md

.DS_Store
