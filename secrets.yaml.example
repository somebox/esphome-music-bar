# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
#
# One credential, and it belongs to the artwork normalizer rather than to the
# panel. The panel itself needs no secrets at all: Wi-Fi arrives over Improv,
# and Home Assistant hands it an encryption key at adoption. See docs/adoption.md.
#
# You can skip this file entirely by setting $MA_TOKEN instead, which is what
# the Home Assistant integration and any container should do.

# Music Assistant long-lived token, from the MA UI under Settings -> Profile.
# The token inside Home Assistant's music_assistant config entry is a
# different credential and will not authenticate against MA's own API port.
ma_api_token: "your-ma-long-lived-token"
