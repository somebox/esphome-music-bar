# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.

# WiFi the panel joins. Many setups put displays on a 2.4GHz-only IoT SSID.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Fallback access point, used when WiFi fails.
ap_password: "change-me"

# ESPHome native API encryption key. Generate a new one:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "generate-your-own"

# OTA update password. Generate a new one:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
ota_password: "generate-your-own"

# Music Assistant long-lived token, from the MA UI under Settings -> Profile.
# The token inside Home Assistant's music_assistant config entry is a
# different credential and will not authenticate against MA's own API port.
ma_api_token: "your-ma-long-lived-token"
